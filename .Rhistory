# ── libraries ────────────────────────────────────────────────────────────
library(httr)
library(readr)
library(dplyr)
library(purrr)
library(tibble)
library(data.table)   # for fast fwrite()
# ── credentials & constants ──────────────────────────────────────────────
apikey   <- "95A548D2-108A-39D9-AAFA-ABC87DFAE9FD"
states   <- state.abb                  # AL, AK, …, WY
years    <- 2000:2020
UA       <- "soybean-dollar-acre/0.1 (your_email@example.com)"
pause    <- 0.4        # seconds between every HTTP hit
tries    <- 5
base_get <- "https://quickstats.nass.usda.gov/api/get_counts/"
base_csv <- "https://quickstats.nass.usda.gov/api/api_GET/"
# ── polite wrappers (unchanged) ──────────────────────────────────────────
polite_GET <- function(url, query) {
resp <- RETRY("GET", url,
query        = query,
user_agent(UA),
times        = tries,
pause_base   = pause,
pause_cap    = 6,
pause_min    = pause,
terminate_on = c(400, 404))
Sys.sleep(pause)
stop_for_status(resp)
resp
}
polite_read_csv <- function(url) {
resp <- RETRY("GET", url,
user_agent(UA),
times        = tries,
pause_base   = pause,
pause_cap    = 6,
pause_min    = pause,
terminate_on = c(400, 404))
Sys.sleep(pause)
stop_for_status(resp)
read_csv(
content(resp, "raw"),
show_col_types = FALSE,
col_types = cols(
state_ansi  = col_character(),
county_ansi = col_character(),
.default    = col_guess()
)
)
}
# ── reusable pull helper --------------------------------------------------
pull_qs <- function(st, yr, commodity, stat, unit) {
qry <- list(
key               = apikey,
commodity_desc    = commodity,
statisticcat_desc = stat,
unit_desc         = unit,
agg_level_desc    = "STATE",   # state level is faster; use COUNTY if needed
freq_desc         = "ANNUAL",
state_alpha       = st,
year              = yr,
format            = "CSV"
)
cnt <- content(polite_GET(base_get, qry),
"parsed", simplifyVector = TRUE)$count
if (cnt == 0) return(NULL)
csv_url <- modify_url(base_csv, query = qry)
polite_read_csv(csv_url)
}
# ── 1. soybean yield  (bu / acre) ────────────────────────────────────────
soy_yield <- pmap(
expand.grid(state = states, year = years, stringsAsFactors = FALSE),
~ pull_qs(..1, ..2,
commodity = "SOYBEANS",
stat      = "YIELD",
unit      = "BU / ACRE")
) |>
compact() |>
bind_rows() |>
transmute(state_alpha, year,
yield_bu_ac = as.numeric(value))
library(httr)
library(readr)
library(dplyr)
library(purrr)
library(data.table)
apikey <- "95A548D2-108A-39D9-AAFA-ABC87DFAE9FD"
states <- state.abb
UA     <- "soybean-dollar-acre/0.2 (your_email@example.com)"
pause  <- 0.4
tries  <- 5
base_csv <- "https://quickstats.nass.usda.gov/api/api_GET/"
pull_one <- function(st, commodity, stat, unit, start_yr) {
qry <- list(
key               = apikey,
commodity_desc    = commodity,
statisticcat_desc = stat,
unit_desc         = unit,
agg_level_desc    = "STATE",
freq_desc         = "ANNUAL",
state_alpha       = st,
year__GE          = start_yr,   # <-- all years ≥ start_yr in one call
format            = "CSV"
)
resp <- RETRY("GET", base_csv,
query = qry,
user_agent(UA),
times = tries,
pause_base = pause,
pause_cap  = 6,
pause_min  = pause,
terminate_on = c(400, 404))
Sys.sleep(pause)
stop_for_status(resp)
read_csv(content(resp, "raw"), show_col_types = FALSE)
}
soy_dollar_acre <- inner_join(soy_yield, soy_price,
by = c("state_alpha", "year")) |>
mutate(dollar_per_acre = yield_bu_ac * price_dol_bu) |>
arrange(state_alpha, year)
soy_yield <- map_dfr(
states,
~ pull_one(.x, "SOYBEANS", "YIELD", "BU / ACRE", 2000)
) |>
transmute(state_alpha, year, yield_bu_ac = as.numeric(value))
