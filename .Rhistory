# ---- polite wrappers -------------------------------------------
polite_GET <- function(url, query) {
resp <- RETRY("GET", url,
query        = query,
user_agent(UA),
times        = tries,
pause_base   = pause,
pause_cap    = 6,
pause_min    = pause,
terminate_on = c(400, 404))
Sys.sleep(pause)
stop_for_status(resp)
resp
}
polite_read_csv <- function(url) {
resp <- RETRY("GET", url,
user_agent(UA),
times        = tries,
pause_base   = pause,
pause_cap    = 6,
pause_min    = pause,
terminate_on = c(400, 404))
Sys.sleep(pause)
stop_for_status(resp)
readr::read_csv(
content(resp, "raw"),
show_col_types = FALSE,
col_types = readr::cols(
state_ansi       = readr::col_character(),
county_ansi      = readr::col_character(),
state_fips_code  = readr::col_character(),
county_fips_code = readr::col_character(),
.default         = readr::col_guess()
)
)
}
