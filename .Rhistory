# ---- polite wrappers -------------------------------------------
polite_GET <- function(url, query) {
resp <- RETRY("GET", url,
query        = query,
user_agent(UA),
times        = tries,
pause_base   = pause,
pause_cap    = 6,
pause_min    = pause,
terminate_on = c(400, 404))
Sys.sleep(pause)
stop_for_status(resp)
resp
}
polite_read_csv <- function(url) {
resp <- RETRY("GET", url,
user_agent(UA),
times        = tries,
pause_base   = pause,
pause_cap    = 6,
pause_min    = pause,
terminate_on = c(400, 404))
Sys.sleep(pause)
stop_for_status(resp)
read_csv(
content(resp, "raw"),
show_col_types = FALSE,
col_types = cols(
state_ansi  = col_character(),
county_ansi = col_character(),
.default    = col_guess()
)
)
}
