pull_fruitnut_area <- function(st, yr) {
qry <- list(
key               = apikey,
sector_desc       = "CROPS",             # broad category
group_desc        = "FRUIT & TREE NUTS", # <-- everything in this group
statisticcat_desc = "AREA HARVESTED",
unit_desc         = "ACRES",
agg_level_desc    = "COUNTY",
freq_desc         = "ANNUAL",
state_alpha       = st,
year              = yr,
format            = "CSV"
)
cnt <- content(polite_GET(base_get, qry),
"parsed", simplifyVector = TRUE)$count
if (cnt == 0) {
message("  • No data for ", st, " ", yr, " (skipped)")
return(NULL)
}
csv_url <- modify_url(base_csv, query = qry)
out <- tryCatch(
polite_read_csv(csv_url),
error = function(e) {
message("  • Failed to download ", st, " ", yr, " (skipped): ",
conditionMessage(e))
return(NULL)
}
)
if (is.null(out)) return(NULL)
message("  • ", nrow(out), " rows added (", st, " ", yr, ")")
out
}
# ---- main loop -------------------------------------------------
all_fruitnut_county <- pmap_dfr(
