# ---- Optimized Pull Function ----
pull_wheat_area <- function(st, yr) {
qry <- list(
key = apikey,
sector_desc = "CROPS",
commodity_desc = "WHEAT",
statisticcat_desc = "AREA HARVESTED",
unit_desc = "ACRES",
agg_level_desc = "COUNTY",
freq_desc = "ANNUAL",
state_alpha = st,
year = yr,
format = "CSV"
)
# First check if data exists
cnt <- content(GET(base_get, query = qry), "parsed")$count
if (cnt == 0) return(NULL)
# Get data and ensure consistent column types
tryCatch({
GET(base_csv, query = qry) %>%
content("raw") %>%
read_csv(
col_types = cols(
county_code = col_character(),  # Force character type
state_ansi = col_character(),
county_ansi = col_character(),
.default = col_character()
),
show_col_types = FALSE
)
}, error = function(e) NULL)
}
# ---- Fast Main Loop ----
all_wheat_county <- map_dfr(
expand.grid(state = states, year = years, stringsAsFactors = FALSE),
function(params) {
res <- pull_wheat_area(params$state, params$year)
if (!is.null(res)) {
res %>%
mutate(across(c(county_code, state_ansi, county_ansi), as.character))
}
},
.id = "request_id"
)
pull_wheat_area <- function(st, yr) {
qry <- list(
key               = apikey,
sector_desc       = "CROPS",
commodity_desc    = "WHEAT",          # ← target commodity
statisticcat_desc = "AREA HARVESTED",
unit_desc         = "ACRES",
agg_level_desc    = "COUNTY",
freq_desc         = "ANNUAL",
state_alpha       = st,
year              = yr,
format            = "CSV"
)
cnt <- content(polite_GET(base_get, qry),
"parsed", simplifyVector = TRUE)$count
if (cnt == 0) {
message("  • No data for ", st, " ", yr, " (skipped)")
return(NULL)
}
csv_url <- modify_url(base_csv, query = qry)
out <- tryCatch(
polite_read_csv(csv_url, col_types = cols(.default = "c")),  # ← This forces all columns to character
error = function(e) {
message("  • Failed to download ", st, " ", yr, " (skipped): ",
conditionMessage(e))
return(NULL)
}
)
if (is.null(out)) return(NULL)
message("  • ", nrow(out), " rows added (", st, " ", yr, ")")
out
}
# ---- main loop -------------------------------------------------
all_wheat_county <- pmap_dfr(
expand.grid(state = states, year = years, stringsAsFactors = FALSE),
~ pull_wheat_area(..1, ..2)
)
pull_wheat_area <- function(st, yr) {
# Build query
qry <- list(
key = apikey,
sector_desc = "CROPS",
commodity_desc = "WHEAT",
statisticcat_desc = "AREA HARVESTED",
unit_desc = "ACRES",
agg_level_desc = "COUNTY",
freq_desc = "ANNUAL",
state_alpha = st,
year = yr,
format = "CSV"
)
# Try to download
tryCatch({
# Get the data
temp_file <- tempfile(fileext = ".csv")
download.file(
url = modify_url(base_csv, query = qry),
destfile = temp_file,
quiet = TRUE
)
# Read with all columns as character
out <- read_csv(temp_file, col_types = cols(.default = "c"))
file.remove(temp_file)  # Clean up
message("  • ", nrow(out), " rows added (", st, " ", yr, ")")
return(out)
}, error = function(e) {
message("  • Failed to download ", st, " ", yr, " (skipped): ", e$message)
return(NULL)
})
}
# Main loop (unchanged)
all_wheat_county <- pmap_dfr(
expand.grid(state = states, year = years, stringsAsFactors = FALSE),
~ pull_wheat_area(..1, ..2)
)
pull_wheat_area <- function(st, yr) {
qry <- list(
key               = apikey,
sector_desc       = "CROPS",
commodity_desc    = "WHEAT",
statisticcat_desc = "AREA HARVESTED",
unit_desc         = "ACRES",
agg_level_desc    = "COUNTY",
freq_desc         = "ANNUAL",
state_alpha       = st,
year              = yr,
format            = "CSV"
)
tryCatch({
temp_file <- tempfile(fileext = ".csv")
download.file(
url     = modify_url(base_csv, query = qry),
destfile= temp_file,
quiet   = TRUE
)
out <- read_csv(temp_file, col_types = cols(.default = "c"))
file.remove(temp_file)
if (nrow(out) == 0) {
message("  • No data for ", st, " ", yr, " (skipped)")
return(data.frame())            # ← empty DF, not NULL
}
message("  • ", nrow(out), " rows added (", st, " ", yr, ")")
out
}, error = function(e) {
message("  • Failed to download ", st, " ", yr, " (skipped): ", e$message)
data.frame()                      # ← empty DF, not NULL
})
}
# ---- main loop, unchanged ----
all_wheat_county <- pmap_dfr(
expand.grid(state = states, year = years, stringsAsFactors = FALSE),
pull_wheat_area
)
