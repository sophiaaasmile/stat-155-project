install.packages("tidyverse")
library(httr)
library(readr)
library(dplyr)
library(purrr)
library(data.table)
library(tidyverse)
apikey <- "95A548D2-108A-39D9-AAFA-ABC87DFAE9FD"
states <- state.abb
UA     <- "soybean-dollar-acre/0.2 (your_email@example.com)"
pause  <- 0.4
tries  <- 5
base_csv <- "https://quickstats.nass.usda.gov/api/api_GET/"
# ---- Simple Pull Function ----
get_soy_data <- function(st, type) {
# Set parameters based on data type
if (type == "yield") {
stat <- "YIELD"
unit <- "BU / ACRE"
} else if (type == "price") {
stat <- "PRICE RECEIVED"
unit <- "$ / BU"
}
tryCatch({
# API call
resp <- GET(
url = "https://quickstats.nass.usda.gov/api/api_GET/",
query = list(
key = apikey,
commodity_desc = "SOYBEANS",
statisticcat_desc = stat,
unit_desc = unit,
agg_level_desc = "STATE",
freq_desc = "ANNUAL",
state_alpha = st,
year__GE = 2000,
format = "CSV"
),
user_agent(UA)
)
# Skip if no data
if (resp$status_code != 200) return(NULL)
# Read and format data
read_csv(content(resp, "raw"), show_col_types = FALSE) |>
select(state_alpha, year, value) |>
mutate(value = as.numeric(value))
}, error = function(e) return(NULL))
}
# ---- Get All Data ----
# Get yield data
soy_yield <- map_dfr(states, ~get_soy_data(.x, "yield"), .id = "state") |>
rename(yield_bu_ac = value)
# ---- Improved Pull Function ----
get_soy_data <- function(st, type) {
# Set parameters
params <- list(
key = apikey,
commodity_desc = "SOYBEANS",
agg_level_desc = "STATE",
freq_desc = "ANNUAL",
state_alpha = st,
year__GE = 2000,
format = "CSV"
)
# Add type-specific parameters
if (type == "yield") {
params$statisticcat_desc <- "YIELD"
params$unit_desc <- "BU / ACRE"
} else if (type == "price") {
params$statisticcat_desc <- "PRICE RECEIVED"
params$unit_desc <- "$ / BU"
}
tryCatch({
resp <- GET(
url = "https://quickstats.nass.usda.gov/api/api_GET/",
query = params,
user_agent(UA)
)
# Return NULL if request failed
if (resp$status_code != 200) return(NULL)
data <- read_csv(content(resp, "raw"), show_col_types = FALSE)
# Return NULL if no value column exists
if (!"value" %in% names(data)) return(NULL)
data %>%
select(state_alpha, year, value) %>%
mutate(value = as.numeric(value))
}, error = function(e) return(NULL))
}
# ---- Get Data Safely ----
get_soy_data_safe <- function(type) {
map_dfr(states, function(st) {
result <- get_soy_data(st, type)
if (!is.null(result)) {
result %>% mutate(state = st)
}
})
}
# Get yield and price data
soy_yield <- get_soy_data_safe("yield") %>%
rename(yield_bu_ac = value)
